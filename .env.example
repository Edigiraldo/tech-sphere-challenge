GROQ_API_KEY=your-groq-api-key

# Optional LLM settings
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Optional RAG settings
RAG_SIMILARITY_THRESHOLD=0.25
RAG_MIN_CHUNKS=2
RAG_MIN_AVG_SIMILARITY=0.30

# Optional LLM cost settings (USD per million tokens)
LLM_INPUT_COST_PER_MILLION=0.59
LLM_OUTPUT_COST_PER_MILLION=0.79
